import QInterp.Model
import QInterp.Props

open QInterp Plausible

def fmtQ (q : Q) : String := s!"[{q.x}, {q.y}, {q.z}, {q.w}]"
def fmtT (t : Times) : String := s!"[{t.toT}, {t.preT}, {t.postT}, {t.prePreT}, {t.postPostT}]"
def fmtErr (e : Float) : String := if e.isNaN then "\"nan\"" else toString e

def caseJson (c : Case) : String :=
  s!"\"family\": \"{c.family}\", \"pre_pre\": {fmtQ c.prePre}, \"pre\": {fmtQ c.pre}, \"from\": {fmtQ c.a}, " ++
  s!"\"to\": {fmtQ c.b}, \"post\": {fmtQ c.post}, \"post_post\": {fmtQ c.postPost}, \"weight\": {c.w}, " ++
  s!"\"times\": {fmtT c.tm}, \"g\": {fmtQ c.g}"

def cppQ (q : Q) : String := s!"Quaternion({q.x}, {q.y}, {q.z}, {q.w})"

def propIndex : Prop_ → Nat
  | .finite => 0 | .unit => 1 | .endpoint0 => 2 | .endpoint1 => 3 | .constant => 4
  | .reversal => 5 | .leftInv => 6 | .geodesic => 7 | .continuity => 8 | .timeUniform => 9

def fnIndex : Fn → Nat | .sci => 0 | .sciInTime => 1 | .makima => 2

structure Failure where
  prop : Prop_
  impl : Impl
  fn : Fn
  err : Float
  c : Case

def cppRow (f : Failure) : String :=
  let c := f.c
  s!"\t\{ {fnIndex f.fn}, {propIndex f.prop}, \"{f.prop.name}\", \"{c.family}\", {cppQ c.prePre}, {cppQ c.pre}, {cppQ c.a}, {cppQ c.b}, " ++
  s!"{cppQ c.post}, {cppQ c.postPost}, {c.w}, \{ {c.tm.toT}, {c.tm.preT}, {c.tm.postT}, {c.tm.prePreT}, {c.tm.postPostT} }, {cppQ c.g}, {fmtErr f.err} },"

