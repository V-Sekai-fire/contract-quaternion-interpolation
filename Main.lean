// Generated by V-Sekai-fire/contract-quaternion-interpolation (lake exe qinterp).
// Each row is an input on which the Lean model of the code before godot PR 124915 (old)
// or of the PR as written (patch) fails an interpolation property. This tree must pass them all.

#include \"tests/test_macros.h\"

TEST_FORCE_LINK(test_quaternion_interpolation_lean)

#include \"core/math/quaternion.h\"
#include \"scene/resources/animation.h\"

namespace TestQuaternionInterpolationLean {

struct Times {
\treal_t to_t, pre_t, post_t, pre_pre_t, post_post_t;
};

struct Row {
\tint fn; // 0 cubic, 1 cubic in time, 2 makima in time
\tint prop;
\tconst char *prop_name;
\tconst char *family;
\tQuaternion pre_pre, pre, from, to, post, post_post;
\treal_t weight;
\tTimes t;
\tQuaternion g;
\tdouble lean_error;
};

static Quaternion run(int p_fn, const Quaternion &pp, const Quaternion &p, const Quaternion &a, const Quaternion &b, const Quaternion &q, const Quaternion &qq, real_t w, const Times &t) {
\tswitch (p_fn) {
\t\tcase 0:
\t\t\treturn a.spherical_cubic_interpolate(b, p, q, w);
\t\tcase 1:
\t\t\treturn a.spherical_cubic_interpolate_in_time(b, p, q, w, t.to_t, t.pre_t, t.post_t);
\t\tdefault:
\t\t\treturn Animation::spherical_makima_interpolate_in_time(a, b, p, q, pp, qq, w, t.to_t, t.pre_t, t.post_t, t.pre_pre_t, t.post_post_t);
\t}
}

static double chord(Quaternion a, Quaternion b) {
\ta = a.normalized();
\tb = b.normalized();
\tdouble d1 = (a - b).length();
\tdouble d2 = (a + b).length();
\treturn MIN(d1, d2);
}

static Quaternion expv(const Vector3 &v) {
\treturn Quaternion(v.x, v.y, v.z, 0).exp();
}

// Returns the measured error of property r.prop on row r (same definitions as QInterp/Props.lean).
static double measure(const Row &r) {
\tconst Times uniform = { 1, -1, 2, -2, 3 };
\tswitch (r.prop) {
\t\tcase 0: {
\t\t\tQuaternion o = run(r.fn, r.pre_pre, r.pre, r.from, r.to, r.post, r.post_post, r.weight, r.t);
\t\t\treturn o.is_finite() ? 0.0 : INFINITY;
\t\t}
\t\tcase 1:
\t\t\treturn Math::abs(run(r.fn, r.pre_pre, r.pre, r.from, r.to, r.post, r.post_post, r.weight, r.t).length() - 1.0);
\t\tcase 2:
\t\t\treturn chord(run(r.fn, r.pre_pre, r.pre, r.from, r.to, r.post, r.post_post, 0, r.t), r.from);
\t\tcase 3:
\t\t\treturn chord(run(r.fn, r.pre_pre, r.pre, r.from, r.to, r.post, r.post_post, 1, r.t), r.to);
\t\tcase 4:
\t\t\treturn chord(run(r.fn, r.from, r.from, r.from, r.from, r.from, r.from, r.weight, r.t), r.from);
\t\tcase 5: {
\t\t\tTimes m = { r.t.to_t, -(r.t.post_t - r.t.to_t), r.t.to_t - r.t.pre_t, -(r.t.post_post_t - r.t.to_t), r.t.to_t - r.t.pre_pre_t };
\t\t\treturn chord(run(r.fn, r.pre_pre, r.pre, r.from, r.to, r.post, r.post_post, r.weight, r.t),
\t\t\t\t\trun(r.fn, r.post_post, r.post, r.to, r.from, r.pre, r.pre_pre, 1 - r.weight, m));
\t\t}
\t\tcase 6: {
\t\t\tconst Quaternion &g = r.g;
\t\t\treturn chord(run(r.fn, g * r.pre_pre, g * r.pre, g * r.from, g * r.to, g * r.post, g * r.post_post, r.weight, r.t),
\t\t\t\t\tg * run(r.fn, r.pre_pre, r.pre, r.from, r.to, r.post, r.post_post, r.weight, r.t));
\t\t}
\t\tcase 7: {
\t\t\tQuaternion l = (r.from.inverse() * r.to).log();
\t\t\tVector3 v(l.x, l.y, l.z);
\t\t\tauto k = [&](real_t s) { return (r.from * expv(v * s)).normalized(); };
\t\t\treturn chord(run(r.fn, k(-2), k(-1), r.from, k(1), k(2), k(3), r.weight, uniform), r.from.slerp(k(1), r.weight));
\t\t}
\t\tcase 8: {
\t\t\tconst real_t h = 1e-4;
\t\t\treal_t w = MIN(r.weight, (real_t)(1 - h));
\t\t\treturn chord(run(r.fn, r.pre_pre, r.pre, r.from, r.to, r.post, r.post_post, w, r.t),
\t\t\t\t\trun(r.fn, r.pre_pre, r.pre, r.from, r.to, r.post, r.post_post, w + h, r.t));
\t\t}
\t\tdefault:
\t\t\treturn chord(run(1, r.pre_pre, r.pre, r.from, r.to, r.post, r.post_post, r.weight, uniform),
\t\t\t\t\trun(0, r.pre_pre, r.pre, r.from, r.to, r.post, r.post_post, r.weight, uniform));
\t}
}

// float real_t: the Lean model runs in double, so a row only counts here above these.
static double tolerance(int p_prop) {
\treturn p_prop == 8 ? 1e-2 : 1e-3;
}

static const Row rows[] = {
"

def cppFooter : String := "};

TEST_CASE(\"[Quaternion][Lean] Interpolation properties on Lean-found inputs\") {
\tfor (const Row &r : rows) {
\t\tdouble err = measure(r);
\t\tCHECK_MESSAGE(err <= tolerance(r.prop), vformat(\"fn %d prop %s family %s: error %f (Lean %f)\", r.fn, r.prop_name, r.family, err, r.lean_error));
\t}
}

} // namespace TestQuaternionInterpolationLean
"

def main (args : List String) : IO UInt32 := do
  let n := (args.head? >>= String.toNat?).getD 20000
  -- Fixed seeds: the same build writes the same failures and the same C++ rows.
  IO.setRandSeed 124915
  IO.FS.createDirAll "out"
  -- 1. Plausible: one search per (property, implementation, function).
  let mut summary : Array String := #[]
  IO.println "== Plausible =="
  for f in Fn.all do
    for p in Prop_.all do
      if !p.appliesTo f then continue
      for i in Impl.all do
        let r ← Testable.checkIO (NamedBinder "c" (∀ c : Case, holds p i f c = true)) (cfg := { numInst := 1500, quiet := true, randomSeed := some 124915 })
        let line := match r with
          | .success _ => s!"{f.name} {p.name} {i.name}: no counterexample in 1500"
          | .gaveUp k => s!"{f.name} {p.name} {i.name}: gave up after {k}"
          | .failure _ xs _ => s!"{f.name} {p.name} {i.name}: COUNTEREXAMPLE {String.intercalate " " xs}"
        IO.println line
        summary := summary.push line
  for (nm, prop) in [("get_nearest_log exp_is_q", nlExpIsQ), ("get_nearest_log nearest", nlNearest)] do
    let r ← Testable.checkIO (NamedBinder "c" (∀ c : NLCase, (prop c).isNone = true)) (cfg := { numInst := 5000, quiet := true, randomSeed := some 124915 })
    let line := match r with
      | .success _ => s!"{nm}: no counterexample in 5000"
      | .gaveUp k => s!"{nm}: gave up after {k}"
      | .failure _ xs _ => s!"{nm}: COUNTEREXAMPLE {String.intercalate " " xs}"
    IO.println line
    summary := summary.push line
  IO.FS.writeFile "out/plausible.txt" (String.intercalate "\n" summary.toList ++ "\n")
  -- 2. Sweep: n generated cases, every property, both implementations; keep every failure.
  IO.println s!"== Sweep of {n} cases =="
  let mut fails : Array Failure := #[]
  let mut counts : Std.HashMap String (Nat × Nat) := {}
  for _ in [0:n] do
    let c ← (SampleableExt.interpSample Case).run 100
    for f in Fn.all do
      for p in Prop_.all do
        if !p.appliesTo f then continue
        for i in Impl.all do
          let key := s!"{f.name}\t{p.name}\t{i.name}"
          let (k, t) := counts.getD key (0, 0)
          match eval p i f c with
          | none => counts := counts.insert key (k, t + 1)
          | some e =>
            counts := counts.insert key (k + 1, t + 1)
            fails := fails.push ⟨p, i, f, e, c⟩
  let jsonl := fails.toList.map (fun x =>
    s!"\{\"function\": \"{x.fn.name}\", \"property\": \"{x.prop.name}\", \"impl\": \"{x.impl.name}\", \"error\": {fmtErr x.err}, {caseJson x.c}}")
  IO.FS.writeFile "out/failures.jsonl" (String.intercalate "\n" jsonl ++ "\n")
  let mut tsv := "function\tproperty\timpl\tfailures\tcases\n"
  for (key, (k, t)) in counts.toList.toArray.qsort (fun a b => a.1 < b.1) do
    tsv := tsv ++ s!"{key}\t{k}\t{t}\n"
  IO.FS.writeFile "out/failure_counts.tsv" tsv
  IO.print tsv
  -- 3. C++ doctest rows: old and patch failures large enough to survive float real_t.
  --    The fixed Godot tree must pass every one of them.
  let mut per : Std.HashMap String Nat := {}
  let mut rowsOut : Array String := #[]
  for x in fails do
    if x.impl == .fixed then continue
    let gross := x.err.isNaN || x.err > (if x.prop == .continuity then 2e-2 else 1e-2)
    if !gross then continue
    let key := s!"{x.fn.name}/{x.prop.name}/{x.c.family}/{x.impl.name}"
    let k := per.getD key 0
    if k >= 5 then continue
    per := per.insert key (k + 1)
    rowsOut := rowsOut.push (cppRow x)
  IO.FS.writeFile "out/test_quaternion_interpolation_lean.cpp"
    (cppHeader ++ String.intercalate "\n" rowsOut.toList ++ "\n" ++ cppFooter)
  IO.println s!"{fails.size} failures recorded; {rowsOut.size} C++ rows"
  -- 4. Gate. The fixed model must not fail; the old and patch models must, or the checks prove nothing.
  let failed (i : Impl) (p : Prop_) : Bool := fails.any (fun x => x.impl == i && x.prop == p)
  let fixedFails := fails.filter (·.impl == .fixed)
  let plausibleFixed := summary.filter (fun l => (l.splitOn " fixed: COUNTEREXAMPLE").length > 1)
  let mut ok := true
  if fixedFails.size > 0 || plausibleFixed.size > 0 then
    IO.eprintln s!"FAIL: fixed model fails {fixedFails.size} sweep cases and {plausibleFixed.size} Plausible searches"
    ok := false
  for (i, p) in [(Impl.old, Prop_.reversal), (Impl.patch, Prop_.endpoint0), (Impl.patch, Prop_.endpoint1)] do
    if !failed i p then
      IO.eprintln s!"FAIL: control {i.name} {p.name} found no failure, so the check cannot fail"
      ok := false
  if ok then IO.println "PASS: fixed model holds every property; old and patch controls fail as expected"
  return (if ok then 0 else 1)
